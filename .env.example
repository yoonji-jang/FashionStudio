# 로컬 실행용 예시. 복사해서 .env로 저장하고 값을 채우세요 (.env는 git에 올라가지 않음).
# GitHub Actions에서는 저장소 Settings > Secrets and variables > Actions에 같은 이름으로 등록합니다.

ACCOUNT=women

# 2단계: 이미지 생성
GEMINI_API_KEY=

# 5·8단계: GitHub Actions에서 Claude Code 실행 (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# 7단계: 인스타 게시 (계정별로 IG_<계정>_...)
IG_WOMEN_TOKEN=
IG_WOMEN_USER_ID=

# 7단계: 이미지 공개 주소 (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# 8단계: 미리보기·승인·알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
